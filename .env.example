# AirWindow backend configuration. Copy to backend/.env (or the repo root .env) for local runs.
# Never commit real secrets. On AWS these are CloudFormation parameters (see scripts/deploy.ps1).

# live   = call Open-Meteo (and OpenAQ if a key is set)
# replay = serve the labelled real-data capture in backend/fixtures/replay_delhi.json
DATA_MODE=live

# Optional: OpenAQ API v3 key (https://explore.openaq.org/register). Backend only — never exposed
# to the browser. Leave empty to keep the observed-station layer off (forecast features still work).
OPENAQ_API_KEY=

# Optional: comma-separated origins allowed by CORS. Not needed when the frontend uses the Vite
# proxy (local) or CloudFront same-origin routing (AWS).
CORS_ORIGINS=

# Optional: path to an alternative replay fixture.
# REPLAY_FILE=backend/fixtures/replay_delhi.json

# Optional (local preview only): serve a built frontend from the API process.
# STATIC_DIR=frontend/dist
