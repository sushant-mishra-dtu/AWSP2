# AirWindow backend configuration. Copy to backend/.env for local runs (git-ignored).
# Never commit real secrets. On AWS these values are set by infra/template.yaml
# (secrets as NoEcho CloudFormation parameters via scripts/deploy.ps1).

# ---- Data
# live   = Open-Meteo (+ OpenAQ if a key is set)
# replay = serve a labelled fixture: backend/fixtures/replay_delhi.json (REAL captured responses)
#          or backend/fixtures/scenario_delhi_synthetic.json (SYNTHETIC demo scenario)
DATA_MODE=live
# REPLAY_FILE=backend/fixtures/replay_delhi.json

# Optional OpenAQ v3 key (https://explore.openaq.org/register). Backend only.
OPENAQ_API_KEY=

# ---- Campus workflow backends (local defaults are labelled LOCAL MODE in the app)
# STORE: local (SQLite file in DATA_DIR) | dynamodb (needs TABLE_NAME + AWS credentials)
STORE=local
TABLE_NAME=
# AUTH_MODE: local (development sign-in, no password, never use in production) | cognito
AUTH_MODE=local
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Optional fixed secret for local dev tokens (otherwise generated into DATA_DIR)
LOCAL_AUTH_SECRET=
# NOTIFIER: local (prepares messages, never sends) | sns (needs TOPIC_ARN)
NOTIFIER=local
TOPIC_ARN=
# EVIDENCE: local (files in DATA_DIR/evidence) | s3 (needs EVIDENCE_BUCKET)
EVIDENCE=local
EVIDENCE_BUCKET=
# DATA_DIR=backend/.data

# ---- Alerts
APP_URL=
ALERT_COOLDOWN_MIN=120
WATCHLIST_ORG_IDS=
MAX_ORGS_PER_RUN=10

# ---- Optional AI wording for coordinator bulletins (deterministic bulletin is always produced)
# Amazon Bedrock model or inference-profile id (empty = disabled)
BEDROCK_MODEL_ID=
# NVIDIA hosted API, used as fallback when Bedrock is unavailable. Keep the key secret.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# ---- Misc
CORS_ORIGINS=
# STATIC_DIR=frontend/dist
