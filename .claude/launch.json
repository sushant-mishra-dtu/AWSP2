{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["backend/scripts/serve.py", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "api-demo-synthetic",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["backend/scripts/serve.py", "--demo", "synthetic", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend", "--", "--host", "127.0.0.1"],
      "port": 5173
    }
  ]
}
